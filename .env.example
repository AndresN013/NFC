# =============================================================================
# Marathon Escudo Vivo - variables de entorno de EJEMPLO
# =============================================================================
# Copie este archivo a `.env` y ajuste los valores.
# NINGUN valor de este archivo es un secreto real. Todos son marcadores de
# posicion para desarrollo local. En produccion los secretos deben provenir de
# un gestor de secretos (AWS Secrets Manager, GCP Secret Manager, Vault) y
# nunca de un archivo versionado. Ver docs/plan-gestion-claves.md
# =============================================================================

NODE_ENV=development

# --- Base de datos -----------------------------------------------------------
DATABASE_URL=postgresql://marathon:marathon_dev_only@localhost:5434/escudo_vivo?schema=public
# Base de datos separada para las pruebas de integracion: `npm test` la borra.
TEST_DATABASE_URL=postgresql://marathon:marathon_dev_only@localhost:5434/escudo_vivo_test?schema=public

# --- API ---------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# URL publica de la API tal como la ven los navegadores de los aficionados
API_PUBLIC_URL=http://localhost:4000

# Secreto de firma de sesiones del panel y de la app Android.
# DEV ONLY - en produccion generar con `openssl rand -base64 48` y almacenar en KMS.
SESSION_SECRET=dev-only-insecure-session-secret-change-me-0000000000

# Pimienta (pepper) para el hash de tokens publicos almacenados.
# DEV ONLY - rotacion documentada en docs/plan-gestion-claves.md
TOKEN_HASH_PEPPER=dev-only-insecure-pepper-change-me-000000000000

# Sal para la seudonimizacion de IP en analitica (rota cada 30 dias).
# DEV ONLY
ANALYTICS_IP_SALT=dev-only-insecure-analytics-salt-change-me-0000

# --- Web del aficionado ------------------------------------------------------
# Base a la que apunta la URL grabada en el chip NDEF
FAN_WEB_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Panel administrativo ----------------------------------------------------
ADMIN_WEB_PUBLIC_URL=http://localhost:3001

# --- Correo simulado (Mailpit) ----------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@escudovivo.local

# --- Proveedor NFC -----------------------------------------------------------
# mock | ntag21x | ntag424dna
# `ntag424dna` NO esta implementado: requiere SDK y hardware. Ver
# docs/guia-ntag424-dna.md
NFC_PROVIDER=mock

# --- Gestion de claves -------------------------------------------------------
# Proveedor del almacen de claves maestras NFC. En el MVP solo existe el
# proveedor `null-kms`, que NO custodia claves: unicamente registra referencias.
# Las claves maestras NUNCA se almacenan en esta base de datos ni en la app movil.
KMS_PROVIDER=null-kms
KMS_KEY_REFERENCE_PREFIX=arn:aws:kms:us-east-1:000000000000:key/PLACEHOLDER

# --- Limites -----------------------------------------------------------------
RATE_LIMIT_VERIFY_PER_MINUTE=20
RATE_LIMIT_LOGIN_PER_MINUTE=5
# Reclamos, transferencias y canjes por hora y por IP. Suba este valor si el
# piloto se ejecuta en una tienda donde muchos clientes comparten la misma IP.
RATE_LIMIT_FAN_WRITE_PER_HOUR=20
# Formularios publicos por hora y por IP: alta de cuenta, casos de soporte y
# solicitudes de privacidad. Un umbral demasiado bajo aqui impediria a alguien
# pedir ayuda o ejercer un derecho, asi que conviene ser generoso.
RATE_LIMIT_PUBLIC_FORMS_PER_HOUR=10

# --- Privacidad --------------------------------------------------------------
# Dias de retencion de eventos de verificacion con detalle tecnico
VERIFICATION_EVENT_RETENTION_DAYS=180
